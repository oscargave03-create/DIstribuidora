rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 && data.sku.matches('^[a-zA-Z0-9_\\-]+$')
        && data.description is string && data.description.size() <= 1000
        && data.quantity is number && data.quantity >= 0
        && data.minQuantity is number && data.minQuantity >= 0
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.userId is string && data.userId == request.auth.uid;
    }

    function isValidHistory(data) {
      return data.id is string && data.id.size() <= 128
        && data.productId is string && data.productId.size() <= 128
        && data.productName is string && data.productName.size() <= 200
        && data.userId is string && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 200
        && data.type is string && data.type.size() <= 32
        && data.changeAmount is number
        && data.previousQuantity is number && data.previousQuantity >= 0
        && data.newQuantity is number && data.newQuantity >= 0
        && data.notes is string && data.notes.size() <= 500;
    }

    function isValidConfig(data) {
      return data.systemTitle is string && data.systemTitle.size() <= 100
        && data.systemSubtitle is string && data.systemSubtitle.size() <= 100
        && data.companyName is string && data.companyName.size() <= 200
        && data.ruc is string && data.ruc.size() <= 32
        && data.telephone is string && data.telephone.size() <= 32
        && data.address is string && data.address.size() <= 300
        && data.receiptFooter is string && data.receiptFooter.size() <= 300
        && data.receiptAd is string && data.receiptAd.size() <= 500
        && (data.logoUrl == null || (data.logoUrl is string && data.logoUrl.size() <= 5000))
        && data.categories is list && data.categories.size() <= 20 
          && (data.categories.size() == 0 || data.categories[0] is string)
        && data.taxes is map
          && data.taxes.generalRate is number
          && data.taxes.liquorRate is number
          && data.taxes.tobaccoRate is number
          && data.taxes.generalName is string
          && data.taxes.liquorName is string
          && data.taxes.tobaccoName is string;
    }

    function isValidPermission(data) {
      return data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 100
        && data.displayName is string && data.displayName.size() <= 100
        && data.role is string && (data.role == "admin" || data.role == "supervisor" || data.role == "cashier" || data.role == "guest")
        && (data.password == null || (data.password is string && data.password.size() <= 100))
        && data.allowedTabs is map
          && data.allowedTabs.dashboard is bool
          && data.allowedTabs.pos is bool
          && data.allowedTabs.alerts is bool
          && data.allowedTabs.reports is bool
          && data.allowedTabs.admin is bool
        && data.allowedActions is map
          && data.allowedActions.create_product is bool
          && data.allowedActions.edit_product is bool
          && data.allowedActions.delete_product is bool
          && data.allowedActions.adjust_stock is bool
          && data.allowedActions.process_sale is bool;
    }

    match /products/{productId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && request.auth.token.email_verified == true
        && isValidId(productId) 
        && isValidProduct(incoming()) 
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn() 
        && request.auth.token.email_verified == true
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
        
      allow delete: if isSignedIn() 
        && request.auth.token.email_verified == true
        && existing().userId == request.auth.uid;
    }

    match /history/{historyId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && request.auth.token.email_verified == true
        && isValidId(historyId) 
        && isValidHistory(incoming()) 
        && incoming().timestamp == request.time;
        
      // Read-only audit log
      allow update, delete: if false;
    }

    match /configs/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create, update: if isSignedIn() 
        && request.auth.token.email_verified == true
        && userId == request.auth.uid 
        && isValidConfig(incoming());
      allow delete: if false;
    }

    match /permissions/{permissionId} {
      allow get, list: if isSignedIn() 
        && (permissionId == request.auth.uid || get(/databases/$(database)/documents/permissions/$(request.auth.uid)).data.role == "admin");
      
      allow create: if isSignedIn() 
        && request.auth.token.email_verified == true
        && permissionId == request.auth.uid 
        && isValidPermission(incoming());
        
      allow update: if isSignedIn() 
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/permissions/$(request.auth.uid)).data.role == "admin"
        && isValidPermission(incoming());
        
      allow delete: if isSignedIn() 
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/permissions/$(request.auth.uid)).data.role == "admin"
        && permissionId != request.auth.uid; // Prevent self-deletion
    }
  }
}
